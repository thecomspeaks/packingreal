      head: [['Date','Invoice No','Dealer','Items','Amount','Parcel Company','Parcel Amount']],
      body: invs.map(g=>[fmtD(g.date), g.invoice, g.dealer, itemSummary(g), money(g.total), g.parcelCompany, g.parcel?money(g.parcel):'']),
      foot: [['TOTAL','','','',money(t.amount),'',money(t.parcel)]],
      showFoot: 'lastPage',
      styles: {fontSize:9, cellPadding:4},
      headStyles: {fillColor:[31,78,121]}, footStyles: {fillColor:[234,241,248], textColor:20, fontStyle:'bold'},
      columnStyles: {4:{halign:'right'}, 6:{halign:'right'}},
      didDrawPage: ()=>pageNo(doc)
    });
    pdfStaff(doc);
    doc.save(fname(tag+'_Main','pdf'));
  } else if(kind==='pdfDetail'){
    const doc = new J({orientation:'portrait', unit:'pt', format:'a4'});
    pdfHead(doc, sub, t);
    const body = [];
    invs.forEach(g=>{
      body.push([{content: fmtD(g.date)+'    Invoice: '+(g.invoice||'-')+'    Dealer: '+g.dealer+
        (g.parcelCompany||g.parcel ? '    Parcel: '+g.parcelCompany+(g.parcel?' '+money(g.parcel):'') : ''),
        colSpan:4, styles:{fillColor:[234,241,248], fontStyle:'bold', textColor:20}}]);
      g.lines.forEach(l=>body.push([l.item, String(l.unit), l.rate===''?'':money(l.rate), money(l.amount)]));
      body.push([{content:'Invoice total', colSpan:3, styles:{halign:'right', fontStyle:'bold'}}, {content:money(g.total), styles:{halign:'right', fontStyle:'bold'}}]);
    });
    doc.autoTable({
      startY: 82,
      head: [['Item','Unit','Rate','Amount']],
      body,
      foot: [
        [{content:'TOTAL AMOUNT', colSpan:3, styles:{halign:'right'}}, {content:money(t.amount), styles:{halign:'right'}}],
        [{content:'TOTAL PARCEL AMOUNT', colSpan:3, styles:{halign:'right'}}, {content:money(t.parcel), styles:{halign:'right'}}]
      ],
      showFoot: 'lastPage',
      styles: {fontSize:9, cellPadding:3.5},
      headStyles: {fillColor:[31,78,121]}, footStyles: {fillColor:[234,241,248], textColor:20, fontStyle:'bold'},
      columnStyles: {1:{halign:'right'}, 2:{halign:'right'}, 3:{halign:'right'}},
      didDrawPage: ()=>pageNo(doc)
    });
    pdfStaff(doc);
    doc.save(fname(tag+'_Detail','pdf'));
  }
}

/* --- Download window --- */
function openDownload(preset){
  fillDealerOptions();
  $('selN').textContent = selected.size ? '('+selected.size+')' : '(none ticked)';
  $('rdSel').disabled = !selected.size;
  const want = preset==='selected' && selected.size ? 'selected' : 'shown';
  document.querySelector('input[name=scope][value='+want+']').checked = true;
  $('dlFrom').value = $('flFrom').value; $('dlTo').value = $('flTo').value;
  if($('flDealer').value) $('dlDealer').value = $('flDealer').value;
  scopeUi();
  $('mDownload').classList.add('show');
}
function fillDealerOptions(){ const cur=$('dlDealer').value; buildFilterOptions(); if(cur) $('dlDealer').value = cur; }
function scopeVal(){ return document.querySelector('input[name=scope]:checked').value; }
function scopeUi(){ $('dlDealerBox').style.display = scopeVal()==='dealer' ? 'grid' : 'none'; }
document.querySelectorAll('input[name=scope]').forEach(r=>r.onchange=scopeUi);
function scopeData(){
  const s = scopeVal();
  if(s==='selected'){
    const invs = invAll.filter(g=>selected.has(g.groupId)).sort((a,b)=>a.date.localeCompare(b.date)||a.idx-b.idx);
    return {invs, sub:'Ticked entries ('+invs.length+')', tag:'Selected'};
  }
  if(s==='dealer'){
    const d=$('dlDealer').value, f=$('dlFrom').value, t=$('dlTo').value;
    if(!d){ toast('Choose a dealer.'); return null; }
    const invs = invAll.filter(g=>g.dealer===d && (!f||g.date>=f) && (!t||g.date<=t)).sort((a,b)=>a.date.localeCompare(b.date)||a.idx-b.idx);
    return {invs, sub:'Dealer: '+d+'   |   Period: '+(f||t ? (f?fmtD(f):'start')+' to '+(t?fmtD(t):'latest') : 'all dates'), tag:safe(d)||'Dealer'};
  }
  const f=$('flFrom').value, t=$('flTo').value;
  return {invs: filteredInvoices(), sub:'Period: '+(f||t ? (f?fmtD(f):'start')+' to '+(t?fmtD(t):'latest') : 'all dates'), tag:'Register'};
}
function dl(kind){ const d = scopeData(); if(d) exportDoc(kind, d.invs, d.sub, d.tag); }
$('dlPdfMain').onclick = ()=>dl('pdfMain');
$('dlPdfDetail').onclick = ()=>dl('pdfDetail');
$('dlXlsx').onclick = ()=>dl('xlsx');
$('dlCsv').onclick = ()=>dl('csv');
$('colChoices').innerHTML = COLS.map(c=>'<label><input type="checkbox" id="col_'+c.k+'" checked> '+c.h+'</label>').join('');

/* --- Dealer View downloads --- */
function dvDl(kind){
  const d = $('dvDealer').value; if(!d){ toast('Select a dealer first.'); return; }
  exportDoc(kind, dvInvoices(), 'Dealer: '+d+'   |   Period: '+dvPeriodText(), safe(d)||'Dealer');
}
$('dvPdfMain').onclick = ()=>dvDl('pdfMain');
$('dvPdfDetail').onclick = ()=>dvDl('pdfDetail');
$('dvXlsx').onclick = ()=>dvDl('xlsx');

/* ---------- events ---------- */
document.querySelectorAll('[data-close]').forEach(b=>b.onclick=()=>b.closest('.modal').classList.remove('show'));
document.querySelectorAll('.modal').forEach(m=>m.addEventListener('mousedown',e=>{ if(e.target===m) m.classList.remove('show'); }));
$('btnSettings').onclick = ()=>{ $('setUrl').value = WEB_URL; $('mSettings').classList.add('show'); };
$('btnDownload').onclick = ()=>openDownload('shown');
$('btnDlSel').onclick = ()=>openDownload('selected');
$('setSave').onclick = async ()=>{
  WEB_URL = $('setUrl').value.trim(); localStorage.setItem(URL_KEY, WEB_URL);
  $('mSettings').classList.remove('show');
  if(await ping(false)){ toast('Connected to Google Sheet.'); loadAll(); }
};
$('status').onclick = async ()=>{ if(await ping(false)) toast('Connected to Google Sheet.'); };
$('btnClear').onclick = clearFilters;
$('btnReload').onclick = loadAll;
document.querySelectorAll('[data-q]').forEach(b=>b.onclick=()=>quick(b.dataset.q));
$('flMonth').onchange = e=>{ const v=e.target.value; if(v) setRange(v+'-01', lastDay(v)); else setRange('',''); };
['flFrom','flTo'].forEach(i=>$(i).onchange=()=>{ $('flMonth').value=''; render(); });
['flDealer','flItem','flParcel','flHasParcel','flSort'].forEach(i=>$(i).onchange=render);
['flRateMin','flRateMax','flAmtMin','flAmtMax','flPaMin','flPaMax','flSearch'].forEach(i=>$(i).oninput=render);

// tabs
document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>{
  document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('on', x===b));
  $('tabEntries').style.display = b.dataset.t==='entries' ? '' : 'none';
  $('tabDealer').style.display = b.dataset.t==='dealer' ? '' : 'none';
  if(b.dataset.t==='dealer') renderDealer();
});
// dealer view controls
document.querySelectorAll('[data-dq]').forEach(b=>b.onclick=()=>{ const [f,t,m]=rangeFor(b.dataset.dq); dvSetRange(f,t,m); });
$('dvMonth').onchange = e=>{ const v=e.target.value; v ? dvSetRange(v+'-01', lastDay(v), v) : dvSetRange('','',''); };
['dvFrom','dvTo'].forEach(i=>$(i).onchange=()=>{ $('dvMonth').value=''; renderDealer(); });
$('dvDealer').onchange = renderDealer;

/* ---------- start ---------- */
resetForm();
quick('month');            // Entries opens on the current month
{ const [f,t,m] = rangeFor('month'); $('dvFrom').value=f; $('dvTo').value=t; $('dvMonth').value=m; }
buildFilterOptions();
render(); renderDealer();
ping(true).then(ok=>{ if(ok) loadAll(); });
setInterval(()=>ping(true), 60000);   // connection light and staff name refresh every minute
</script>
