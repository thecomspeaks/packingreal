function filteredInvoices(){
  const from=$('flFrom').value, to=$('flTo').value, dealer=$('flDealer').value, item=$('flItem').value.toLowerCase(),
    parcel=$('flParcel').value, hp=$('flHasParcel').value,
    rmin=num($('flRateMin').value), rmax=num($('flRateMax').value), amin=num($('flAmtMin').value), amax=num($('flAmtMax').value),
    pmin=num($('flPaMin').value), pmax=num($('flPaMax').value), q=$('flSearch').value.trim().toLowerCase();
  const out = [];
  invAll.forEach(g=>{
    if(from && g.date<from) return;
    if(to && g.date>to) return;
    if(dealer && g.dealer!==dealer) return;
    if(parcel && g.parcelCompany!==parcel) return;
    const has = !!g.parcelCompany || g.parcel>0;
    if(hp==='with' && !has) return;
    if(hp==='without' && has) return;
    if(pmin!==null && g.parcel<pmin) return;
    if(pmax!==null && g.parcel>pmax) return;
    const ls = g.lines.filter(x=>{
      if(item && x.item.toLowerCase()!==item) return false;
      const rate=Number(x.rate)||0, amt=Number(x.amount)||0;
      if(rmin!==null && rate<rmin) return false;
      if(rmax!==null && rate>rmax) return false;
      if(amin!==null && amt<amin) return false;
      if(amax!==null && amt>amax) return false;
      if(q && ![g.date,fmtD(g.date),g.invoice,g.dealer,g.parcelCompany,x.item,x.unit,x.rate,x.amount].join(' ').toLowerCase().includes(q)) return false;
      return true;
    });
    if(!ls.length) return;
    out.push(Object.assign({}, g, {lines:ls, total:sumBy(ls,'amount')}));
  });
  const by = {
    dateDesc:(a,b)=>b.date.localeCompare(a.date)||b.idx-a.idx,
    dateAsc:(a,b)=>a.date.localeCompare(b.date)||a.idx-b.idx,
    amtDesc:(a,b)=>b.total-a.total,
    paDesc:(a,b)=>b.parcel-a.parcel,
    dealerAsc:(a,b)=>a.dealer.localeCompare(b.dealer)||b.date.localeCompare(a.date),
    invoiceAsc:(a,b)=>String(a.invoice).localeCompare(String(b.invoice),undefined,{numeric:true})
  }[$('flSort').value];
  return out.sort(by);
}

