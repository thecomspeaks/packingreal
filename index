async function saveEntry(){
  if(!WEB_URL){ toast('Set the Web App URL in Settings first.'); return; }
  const header = {
    date: $('fDate').value, invoice: clean($('fInvoice').value), dealer: clean($('fDealer').value),
    parcelCompany: clean($('fParcel').value), parcelAmount: $('fParcelAmt').value
  };
  if(!header.date){ toast('Please enter the date.'); $('fDate').focus(); return; }
  if(!header.dealer){ toast('Please enter the dealer.'); $('fDealer').focus(); return; }
  const lines = [];
  for(const l of lineEls()){
    if(lineEmpty(l)) continue;
    const item = clean(l.querySelector('.li').value), unit = l.querySelector('.lu').value, rate = l.querySelector('.lr').value;
    if(!item){ toast('An item line has no item name.'); l.querySelector('.li').focus(); return; }
    if(num(unit)===null){ toast('Enter the Unit for "'+item+'".'); l.querySelector('.lu').focus(); return; }
    lines.push({item, unit, rate});
  }
  if(!lines.length){ toast('Add at least one item.'); lineEls()[0].querySelector('.li').focus(); return; }
  $('btnSave').disabled = true; setStatus('busy','Saving...');
  try{
    const r = await apiPost({action:'save', header, lines});
    if(!r.ok) throw new Error(r.error);
    toast('Saved ' + lines.length + ' item line(s).');
    const d = header.date;
