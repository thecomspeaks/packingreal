/* ---------- suggestions ---------- */
function attachSuggest(input, getList, onPick){
  const box = document.createElement('div'); box.className='sug';
  input.parentNode.appendChild(box);
  let list = [], idx = -1;
  const query = () => input.value.trim();
  function hide(){ box.style.display='none'; idx=-1; }
  function show(){
    const q = query().toLowerCase();
    list = getList().filter(s => !q || s.toLowerCase().includes(q))
      .sort((a,b)=>{ const as=a.toLowerCase().startsWith(q), bs=b.toLowerCase().startsWith(q); return as===bs ? a.localeCompare(b) : as ? -1 : 1; })
      .slice(0,8);
    idx = -1;
    if(!list.length){ hide(); return; }
    box.innerHTML = list.map((s,i)=>{
      const k = s.toLowerCase().indexOf(q);
      const label = q && k>=0 ? esc(s.slice(0,k))+'<b>'+esc(s.slice(k,k+q.length))+'</b>'+esc(s.slice(k+q.length)) : esc(s);
      return '<div data-i="'+i+'">'+label+'</div>';
    }).join('');
    box.style.display='block';
  }
  function pick(s){ input.value = s; hide(); if(onPick) onPick(); }
  function mark(){ [...box.children].forEach((c,i)=>c.classList.toggle('on', i===idx)); }
  input.addEventListener('input', show);
  input.addEventListener('focus', show);
  input.addEventListener('blur', ()=>{
    const v = clean(input.value);
    const m = getList().find(s=>s.toLowerCase()===v.toLowerCase());
    input.value = m || v;
    setTimeout(hide,150);
  });
  input.addEventListener('keydown', e=>{
    if(box.style.display!=='block') return;
    if(e.key==='ArrowDown'){ e.preventDefault(); idx=(idx+1)%list.length; mark(); }
    else if(e.key==='ArrowUp'){ e.preventDefault(); idx=(idx-1+list.length)%list.length; mark(); }
    else if((e.key==='Enter'||e.key==='Tab') && idx>=0){ pick(list[idx]); }   // Enter/Tab then moves to the next box
    else if(e.key==='Escape') hide();
  });
  box.addEventListener('mousedown', e=>{ e.preventDefault(); const d=e.target.closest('[data-i]'); if(d){ pick(list[+d.dataset.i]); input.focus(); } });
}
