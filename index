<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Tenkasi Packing Material Register</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
<style>
:root{--bg:#f3f6fa;--card:#fff;--ink:#1c2733;--mute:#6b7a8a;--line:#dde4ec;--brand:#1f4e79;--brand2:#2f6fa8;--ok:#1e9e5a;--bad:#d64545;--warn:#e0a21b}
*{box-sizing:border-box}
body{margin:0;font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;background:var(--bg);color:var(--ink);font-size:14px}
header{background:var(--brand);color:#fff;padding:12px 16px;display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:20}
header h1{font-size:18px;margin:0;font-weight:600}
.hr{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.chip{background:rgba(255,255,255,.14);padding:6px 10px;border-radius:20px;font-size:13px;display:none}
.status{display:flex;align-items:center;gap:6px;background:rgba(255,255,255,.14);padding:6px 10px;border-radius:20px;cursor:pointer;font-size:13px;user-select:none}
.dot{width:10px;height:10px;border-radius:50%;background:var(--bad)}
.dot.ok{background:#4be08f}.dot.busy{background:var(--warn)}.dot.err{background:#ff6b6b}
button{font:inherit;cursor:pointer;border:1px solid var(--line);background:#fff;color:var(--ink);padding:7px 12px;border-radius:7px}
button:hover{background:#eef3f8}
button:disabled{opacity:.5;cursor:default}
button.pri{background:var(--brand2);border-color:var(--brand2);color:#fff}
button.pri:hover,button.pri:focus{background:var(--brand)}
button.hd{background:rgba(255,255,255,.14);border-color:transparent;color:#fff}
button.hd:hover{background:rgba(255,255,255,.25)}
button.sm{padding:3px 8px;font-size:12px}
main{max-width:1280px;margin:0 auto;padding:14px}
.tabs{display:flex;gap:6px;margin-bottom:14px}
.tab{border-radius:20px;padding:7px 18px;background:#fff}
.tab.on{background:var(--brand2);border-color:var(--brand2);color:#fff}
.card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:14px;margin-bottom:14px}
.card h2{font-size:14px;margin:0 0 10px;color:var(--brand);text-transform:uppercase;letter-spacing:.04em}
.card h2 small{text-transform:none;letter-spacing:0;font-weight:400}
.grid{display:grid;gap:10px;grid-template-columns:repeat(auto-fit,minmax(150px,1fr))}
.head5{display:grid;gap:10px;grid-template-columns:repeat(5,1fr)}
label{display:block;font-size:12px;color:var(--mute);margin-bottom:3px}
input,select{width:100%;font:inherit;padding:8px 9px;border:1px solid var(--line);border-radius:7px;background:#fff;color:var(--ink)}
input:focus,select:focus,button:focus-visible{outline:2px solid #b6d3ee;border-color:var(--brand2)}
.f{position:relative}
.sug{position:absolute;left:0;right:0;top:100%;background:#fff;border:1px solid var(--line);border-radius:7px;box-shadow:0 6px 18px rgba(0,0,0,.12);z-index:30;max-height:230px;overflow:auto;display:none}
.sug div{padding:7px 10px;cursor:pointer}
.sug div.on,.sug div:hover{background:#e6f0fa}
.sug b{color:var(--brand2)}
/* item lines */
.lines{margin-top:14px}
.line{display:grid;grid-template-columns:3fr 1.1fr 1.1fr 1.1fr 34px;gap:8px;margin-bottom:8px;align-items:center}
.line.head{font-size:12px;color:var(--mute);margin-bottom:3px}
.la{text-align:right;padding-right:6px;font-weight:600}
.line .x{padding:5px 0;color:var(--bad)}
.foot{display:flex;flex-wrap:wrap;gap:14px;align-items:center;margin-top:10px}
.foot .sp{flex:1}
.sw{display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13px;color:var(--ink);margin:0}
.sw input{display:none}
.sw i{width:36px;height:20px;border-radius:10px;background:#c5ced8;position:relative;transition:.2s;flex:none}
.sw i:after{content:"";position:absolute;top:2px;left:2px;width:16px;height:16px;border-radius:50%;background:#fff;transition:.2s}
.sw input:checked+i{background:var(--ok)}
.sw input:checked+i:after{left:18px}
.itot{font-weight:600}
.quick{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px}
.quick button{padding:5px 10px;font-size:12.5px;border-radius:16px}
.actions{display:flex;gap:8px;align-items:end}
.tw{overflow:auto;border:1px solid var(--line);border-radius:8px}
table{border-collapse:collapse;width:100%}
.main{min-width:900px}
th,td{padding:8px 10px;border-bottom:1px solid var(--line);text-align:left;white-space:nowrap}
th{background:#eaf1f8;position:sticky;top:0;font-size:12.5px}
td.n,th.n{text-align:right}
td.c,th.c{width:34px;padding-left:10px;padding-right:2px}
td.c input,th.c input{width:auto}
td.tg{width:20px;padding:8px 2px;color:var(--mute)}
tr.inv{cursor:pointer}
tr.inv:hover td{background:#f7fafd}
tr.det td{background:#fafcfe;white-space:normal}
.mini{width:auto;min-width:380px;margin:2px 0 4px}
.mini th{position:static;background:#f0f5fa;font-size:12px}
.mini td,.mini th{padding:5px 12px;border-bottom:1px solid #e8eef4}
.totals{display:flex;gap:18px;flex-wrap:wrap;margin-top:10px;font-weight:600}
.totals span{color:var(--mute);font-weight:400}
.empty{padding:30px;text-align:center;color:var(--mute)}
.banner{background:#fff6dd;border:1px solid #efd88f;padding:10px 14px;border-radius:8px;margin-bottom:14px;display:none}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.4);display:none;align-items:center;justify-content:center;z-index:50;padding:14px}
.modal.show{display:flex}
.box{background:#fff;border-radius:12px;padding:18px;width:100%;max-width:560px;max-height:90vh;overflow:auto}
.box h3{margin:0 0 10px}
.rad{display:flex;gap:8px;align-items:center;font-size:14px;color:var(--ink);margin:7px 0}
.rad input{width:auto}
.grid3{display:grid;gap:8px;grid-template-columns:2fr 1fr 1fr;margin:4px 0 6px 24px}
.cols{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin:8px 0}
.cols label{display:flex;gap:6px;align-items:center;font-size:13.5px;color:var(--ink);margin:0}
.cols input{width:auto}
.row{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
.sec{font-size:12px;color:var(--mute);margin-top:14px;text-transform:uppercase;letter-spacing:.04em}
.cards{display:grid;gap:10px;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));margin-bottom:14px}
.cards div{background:#eaf1f8;border-radius:8px;padding:10px 12px}
.cards span{display:block;font-size:12px;color:var(--mute)}
.cards b{font-size:17px}
.blk{border:1px solid var(--line);border-radius:8px;margin-bottom:10px;overflow:hidden}
.blk .bh{background:#eaf1f8;padding:8px 12px;display:flex;flex-wrap:wrap;gap:6px 18px;font-weight:600}
.blk .bh span{font-weight:400;color:var(--mute)}
.blk table{min-width:0}
#toast{position:fixed;bottom:18px;left:50%;transform:translateX(-50%);background:#1c2733;color:#fff;padding:9px 16px;border-radius:8px;display:none;z-index:99;max-width:90%}
small{color:var(--mute)}
@media(max-width:820px){.head5{grid-template-columns:repeat(2,1fr)}}
@media(max-width:600px){header h1{font-size:15px}.line{grid-template-columns:2.4fr 1fr 1fr 34px}.line .la,.line.head .la{display:none}.grid3{grid-template-columns:1fr;margin-left:0}}
</style>
</head>
<body>

<header>
  <h1>Tenkasi Packing Material Register</h1>
  <div class="hr">
    <div class="chip" id="staff"></div>
    <div class="status" id="status" title="Click to check connection"><span class="dot err" id="dot"></span><span id="stText">Not connected</span></div>
    <button class="hd" id="btnDownload">Download</button>
    <button class="hd" id="btnSettings">Settings</button>
  </div>
</header>

<main>
  <div class="banner" id="banner">The register is not connected to a Google Sheet yet. Click <b>Settings</b> and paste your Web App URL.</div>

  <div class="tabs">
    <button class="tab on" data-t="entries">Entries</button>
    <button class="tab" data-t="dealer">Dealer View</button>
  </div>

  <!-- ================= ENTRIES TAB ================= -->
  <div id="tabEntries">
    <div class="card" id="formCard">
      <h2>New entry</h2>
      <div class="head5">
        <div><label>Date</label><input type="date" id="fDate"></div>
        <div><label>Invoice No</label><input id="fInvoice" autocomplete="off"></div>
        <div class="f"><label>Dealer</label><input id="fDealer" autocomplete="off"></div>
        <div class="f"><label>Parcel Company</label><input id="fParcel" autocomplete="off"></div>
        <div><label>Parcel Amount</label><input id="fParcelAmt" inputmode="decimal" autocomplete="off"></div>
      </div>

      <div class="lines" id="lines">
        <div class="line head"><span>Item</span><span>Unit</span><span>Rate</span><span class="la">Amount</span><span></span></div>
      </div>

      <div class="foot">
        <button id="btnAddLine" type="button">+ Add item line</button>
        <label class="sw" title="Fill the rate from the last time this item was entered"><input type="checkbox" id="autofill"><i></i>Autofill rate</label>
        <span class="sp"></span>
        <span class="itot">Items total: <span id="iTotal">0.00</span></span>
        <button class="pri" id="btnSave" type="button">Save</button>
      </div>
      <small>Enter = next box. On the last Rate box, Enter adds a new item line. Press Enter on an empty Item box to jump to Save. Ctrl+Enter saves.</small>
    </div>

    <div class="card">
      <h2>Filters</h2>
      <div class="quick">
        <button data-q="today">Today</button>
        <button data-q="week">This Week</button>
        <button data-q="month">This Month</button>
        <button data-q="lastmonth">Last Month</button>
        <button data-q="year">This Year</button>
        <button data-q="all">All Time</button>
      </div>
      <div class="grid">
        <div><label>Month</label><input type="month" id="flMonth"></div>
        <div><label>From date</label><input type="date" id="flFrom"></div>
        <div><label>To date</label><input type="date" id="flTo"></div>
        <div><label>Dealer</label><select id="flDealer"></select></div>
        <div><label>Item</label><select id="flItem"></select></div>
        <div><label>Parcel Company</label><select id="flParcel"></select></div>
        <div><label>Parcel</label>
          <select id="flHasParcel"><option value="">All entries</option><option value="with">With parcel</option><option value="without">Without parcel</option></select></div>
        <div><label>Rate min</label><input id="flRateMin" inputmode="decimal"></div>
        <div><label>Rate max</label><input id="flRateMax" inputmode="decimal"></div>
        <div><label>Amount min</label><input id="flAmtMin" inputmode="decimal"></div>
        <div><label>Amount max</label><input id="flAmtMax" inputmode="decimal"></div>
        <div><label>Parcel amount min</label><input id="flPaMin" inputmode="decimal"></div>
        <div><label>Parcel amount max</label><input id="flPaMax" inputmode="decimal"></div>
        <div><label>Search (invoice, dealer, item...)</label><input id="flSearch" placeholder="type to search"></div>
        <div><label>Sort by</label>
          <select id="flSort">
            <option value="dateDesc">Date - newest first</option>
            <option value="dateAsc">Date - oldest first</option>
            <option value="amtDesc">Invoice amount - high to low</option>
            <option value="paDesc">Parcel amount - high to low</option>
            <option value="dealerAsc">Dealer A-Z</option>
            <option value="invoiceAsc">Invoice No</option>
          </select></div>
        <div class="actions"><button id="btnClear">Clear filters</button><button id="btnReload">Refresh</button></div>
      </div>
    </div>

    <div class="card">
      <h2>Entries <small id="rangeLabel"></small></h2>
      <div class="foot" style="margin:0 0 10px">
        <small>One line per invoice. Click a line to see all its items. Saved entries can be changed only in the Google Sheet (press Refresh after).</small>
        <span class="sp"></span>
        <small id="selInfo"></small>
        <button class="pri sm" id="btnDlSel" style="display:none">Download ticked</button>
      </div>
      <div class="tw">
        <table class="main">
          <thead><tr>
            <th class="c"><input type="checkbox" id="selAll" title="Tick all shown"></th><th></th>
            <th>Date</th><th>Invoice No</th><th>Dealer</th><th>Items</th>
            <th class="n">Amount</th><th>Parcel Company</th><th class="n">Parcel Amount</th>
          </tr></thead>
          <tbody id="tbody"></tbody>
        </table>
        <div class="empty" id="empty" style="display:none"></div>
      </div>
      <div class="totals">
        <div><span>Invoices:</span> <b id="tInv">0</b></div>
        <div><span>Item lines:</span> <b id="tCount">0</b></div>
        <div><span>Total Amount:</span> <b id="tAmt">0.00</b></div>
        <div><span>Total Parcel Amount:</span> <b id="tPa">0.00</b></div>
      </div>
    </div>
  </div>

  <!-- ================= DEALER VIEW TAB ================= -->
  <div id="tabDealer" style="display:none">
    <div class="card">
      <h2>Dealer view <small>- see what was received from a dealer</small></h2>
      <div class="quick">
        <button data-dq="month">This Month</button>
        <button data-dq="lastmonth">Last Month</button>
        <button data-dq="year">This Year</button>
        <button data-dq="all">All Time</button>
      </div>
      <div class="grid">
        <div><label>Dealer</label><select id="dvDealer"></select></div>
        <div><label>Month</label><input type="month" id="dvMonth"></div>
        <div><label>From date</label><input type="date" id="dvFrom"></div>
        <div><label>To date</label><input type="date" id="dvTo"></div>
      </div>
      <div class="row">
        <button class="pri" id="dvPdfMain">PDF - Main</button>
        <button class="pri" id="dvPdfDetail">PDF - Detail</button>
        <button id="dvXlsx">Excel</button>
      </div>
    </div>
    <div id="dvOut"></div>
  </div>
</main>

<!-- Settings -->
<div class="modal" id="mSettings"><div class="box">
  <h3>Settings</h3>
  <label>Google Apps Script Web App URL</label>
  <input id="setUrl" placeholder="https://script.google.com/macros/s/.../exec">
  <p><small>Deploy the Apps Script as a Web app (access: Anyone), copy the URL and paste it here. It is saved in this browser.</small></p>
  <div class="row"><button class="pri" id="setSave">Save &amp; Test</button><button data-close>Close</button></div>
</div></div>

<!-- Download -->
<div class="modal" id="mDownload"><div class="box">
  <h3>Download</h3>
  <div class="sec" style="margin-top:0">What to download</div>
  <label class="rad"><input type="radio" name="scope" value="shown" checked> Everything shown in the Entries table (after filters)</label>
  <label class="rad"><input type="radio" name="scope" value="selected" id="rdSel"> Only the ticked entries <span id="selN"></span></label>
  <label class="rad"><input type="radio" name="scope" value="dealer"> One dealer for a period</label>
  <div class="grid3" id="dlDealerBox">
    <div><label>Dealer</label><select id="dlDealer"></select></div>
    <div><label>From</label><input type="date" id="dlFrom"></div>
    <div><label>To</label><input type="date" id="dlTo"></div>
  </div>

  <div class="sec">PDF</div>
  <div class="row" style="margin-top:6px">
    <button class="pri" id="dlPdfMain" title="One line per invoice">PDF - Main (one line per invoice)</button>
    <button class="pri" id="dlPdfDetail" title="All items under each invoice">PDF - Detail (all items)</button>
  </div>

  <div class="sec">Excel / CSV (one row per item) - columns</div>
  <div class="cols" id="colChoices"></div>
  <div class="row" style="margin-top:6px">
    <button id="dlXlsx">Excel (.xlsx)</button>
    <button id="dlCsv">CSV</button>
    <button data-close>Close</button>
  </div>
</div></div>

<div id="toast"></div>

<script>
const $ = id => document.getElementById(id);
const URL_KEY = 'tkRegisterUrl', AUTO_KEY = 'tkAutofill';
let WEB_URL = localStorage.getItem(URL_KEY) || '';
let rows = [];            // one item line per row (as in the Sheet)
let invAll = [];          // all invoices (rows grouped by invoice)
let curInv = [];          // invoices currently shown in the Entries table
let sugg = {'Item':[], 'Dealer':[], 'Parcel Company':[]};
let staff = null;
let lastRate = {};
let dirty = false;
const selected = new Set();   // ticked invoices
const openG = new Set();      // invoices whose items are expanded

/* ---------- helpers ---------- */
const pad = n => String(n).padStart(2,'0');
const iso = d => d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate());
const fmtD = s => { if(!s) return ''; const p = s.split('-'); return p.length===3 ? p[2]+'-'+p[1]+'-'+p[0] : s; };
const money = n => (Number(n)||0).toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2});
const esc = s => String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const num = v => { const n = parseFloat(v); return isNaN(n) ? null : n; };
const uniq = a => { const m={}; a.forEach(x=>{ if(x){ const k=String(x).toLowerCase(); if(!m[k]) m[k]=x; } }); return Object.values(m); };
const clean = s => String(s||'').trim().replace(/\s+/g,' ');
const sumBy = (a,k) => a.reduce((t,x)=>t+(Number(x[k])||0),0);
function toast(msg, ms=2800){ const t=$('toast'); t.textContent=msg; t.style.display='block'; clearTimeout(t._t); t._t=setTimeout(()=>t.style.display='none',ms); }
function numOnly(el){
  el.addEventListener('input',()=>{
    let v = el.value.replace(/[^0-9.]/g,''); const p = v.indexOf('.');
    if(p>=0) v = v.slice(0,p+1)+v.slice(p+1).replace(/\./g,'');
    if(v!==el.value) el.value = v;
  });
}
function lastDay(ym){ const [y,m]=ym.split('-').map(Number); return iso(new Date(y,m,0)); }
function rangeFor(q){
  const now=new Date(), y=now.getFullYear(), m=now.getMonth();
  if(q==='today') return [iso(now),iso(now),''];
  if(q==='week'){ const d=(now.getDay()+6)%7; return [iso(new Date(y,m,now.getDate()-d)), iso(new Date(y,m,now.getDate()-d+6)), '']; }
  if(q==='month') return [iso(new Date(y,m,1)), iso(new Date(y,m+1,0)), y+'-'+pad(m+1)];
  if(q==='lastmonth'){ const s=new Date(y,m-1,1); return [iso(s), iso(new Date(y,m,0)), s.getFullYear()+'-'+pad(s.getMonth()+1)]; }
  if(q==='year') return [y+'-01-01', y+'-12-31', ''];
  return ['','',''];
}

/* ---------- grouping: item lines -> invoices ---------- */
function groupRows(list){
  const m = new Map();
  list.forEach(r=>{
    const key = r.groupId || ('m|'+r.date+'|'+r.invoice+'|'+r.dealer);
    let g = m.get(key);
    if(!g){ g = {groupId:key, date:r.date, invoice:r.invoice, dealer:r.dealer, parcelCompany:'', parcel:0, lines:[], idx:r.idx}; m.set(key,g); }
    g.lines.push(r);
    if(r.parcelCompany && !g.parcelCompany) g.parcelCompany = r.parcelCompany;
    g.parcel += Number(r.parcelAmount)||0;
    if(r.idx > g.idx) g.idx = r.idx;
  });
  const out = [...m.values()];
  out.forEach(g=>{ g.total = sumBy(g.lines,'amount'); });
  return out;
}
function itemSummary(g){
  const n = g.lines.map(l=>l.item);
  return n.length<=2 ? n.join(', ') : n.slice(0,2).join(', ') + ' +' + (n.length-2) + ' more';
}
function totalsOf(invs){
  return {invoices: invs.length, lines: invs.reduce((a,g)=>a+g.lines.length,0), amount: sumBy(invs,'total'), parcel: sumBy(invs,'parcel')};
}

/* ---------- staff ---------- */
function staffText(){
  if(!staff || !staff.name) return '';
  return (staff.designation||'Packing In-charge') + ': ' + staff.name + (staff.ec ? '  |  EC No: ' + staff.ec : '');
}
function renderStaff(){ const t=staffText(); const el=$('staff'); el.textContent=t; el.style.display = t ? 'block' : 'none'; }

/* ---------- connection ---------- */
function setStatus(state, text){ $('dot').className='dot '+state; $('stText').textContent=text; }
function apiUrl(action){ return WEB_URL + (WEB_URL.includes('?')?'&':'?') + 'action=' + action + '&_=' + Date.now(); }
async function apiGet(action){
  const ctl = new AbortController(); const to = setTimeout(()=>ctl.abort(), 25000);
  try{ const r = await fetch(apiUrl(action), {signal: ctl.signal}); return await r.json(); }
  finally{ clearTimeout(to); }
}
async function apiPost(payload){
  const ctl = new AbortController(); const to = setTimeout(()=>ctl.abort(), 30000);
  try{ const r = await fetch(WEB_URL, {method:'POST', body: JSON.stringify(payload), signal: ctl.signal}); return await r.json(); }
  finally{ clearTimeout(to); }
}
async function ping(silent){
  if(!WEB_URL){ setStatus('err','Not connected'); $('banner').style.display='block'; return false; }
  $('banner').style.display='none';
  setStatus('busy','Checking...');
  try{
    const r = await apiGet('ping');
    if(r && r.ok){ setStatus('ok','Connected'); staff = r.staff || null; renderStaff(); return true; }
    throw new Error((r&&r.error)||'Bad reply');
  }catch(e){
    setStatus('err','Not connected');
    if(!silent) toast('Cannot reach the Google Sheet. Check the URL, deployment access (Anyone) and internet.');
    return false;
  }
}
async function loadAll(){
  if(!WEB_URL){ render(); renderDealer(); return; }
  setStatus('busy','Syncing...');
  try{
    const r = await apiGet('all');
    if(!r.ok) throw new Error(r.error);
    rows = (r.rows || []).map((x,i)=>Object.assign({idx:i}, x));
    invAll = groupRows(rows);
    // forget ticked / opened invoices that no longer exist
    const ids = new Set(invAll.map(g=>g.groupId));
